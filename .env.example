# =====================================================================
# PLATIA — Variables de entorno del núcleo mínimo (basado en el Apéndice F)
#
#   1. python scripts/generate_env.py   -> crea .env con secretos aleatorios
#   2. Edita .env y pon tu ANTHROPIC_API_KEY
#
# NUNCA subas el fichero .env al repositorio (ya está en .gitignore).
# Los valores <GENERAR> los rellena el script; no los escribas a mano.
# =====================================================================

# --- Puerto público (Nginx) ---
HTTP_PORT=8080

# --- Base de datos (MySQL 8.0, tres esquemas) ---
MYSQL_ROOT_PASSWORD=<GENERAR>
DB_USER=platform_user
DB_PASSWORD=<GENERAR>
DB_NAME_CORE=platform_core          # Plataforma transversal: usuarios, auditoría, IA
DB_NAME_OPS=operations_db           # Datos de negocio
DB_NAME_ANALYTICS=analytics_db      # Inteligencia de negocio
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_PASSWORD=<GENERAR>
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1

# --- Aplicación ---
APP_SECRET_KEY=<GENERAR>
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | text
TIMEZONE=Europe/Madrid

# --- Seguridad e IAM (fase 3) ---
JWT_SECRET_KEY=<GENERAR>
MFA_ENCRYPTION_KEY=<GENERAR_FERNET>  # cifra los secretos MFA; si la cambias, hay que reactivar el MFA
JWT_ACCESS_MINUTES=30
JWT_REFRESH_MINUTES=480
COOKIE_SECURE=false                 # true en cuanto haya HTTPS
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Backend de negocio y colas (fase 4) ---
RATE_LIMIT_READ=60                  # peticiones por minuto y usuario: lecturas
RATE_LIMIT_WRITE=20                 # escrituras
RATE_LIMIT_UPLOAD=10                # subidas de ficheros
RATE_LIMIT_EXPORT=5                 # exportaciones CSV
DOCUMENT_MAX_MB=100                 # tamaño máximo de un documento (Nginx admite 100 MB)
# Feeds ATOM de licitaciones: nombre|https://url separados por comas. Vacío = desactivado.
# Ejemplo: OPPORTUNITY_FEEDS=placsp|https://contrataciondelestado.es/sindicacion/...atom
OPPORTUNITY_FEEDS=
ALERT_SCORE_THRESHOLD=7.0           # puntuación (0-10) a partir de la que se avisa
DEAL_STALLED_DAYS=14                # días sin cambios para avisar de una propuesta parada
NOTIFICATION_RETENTION_DAYS=90      # las notificaciones leídas se borran pasado este plazo
AUDIT_ANONYMIZE_DAYS=365            # la auditoría pierde IP y navegador pasado este plazo (RGPD)
CELERY_TASK_TIME_LIMIT=600

# --- Servicio de IA interno (clave compartida backend <-> ai_service) ---
AI_SERVICE_API_KEY=<GENERAR>

# --- Anthropic (Claude) — la pones tú ---
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5   # Tareas estándar
CLAUDE_PREMIUM_MODEL=claude-opus-5-5     # Tareas que requieren máxima capacidad
CLAUDE_FAST_MODEL=claude-haiku-5-5       # Clasificación e intención

# --- Qdrant (vectores) ---
QDRANT_API_KEY=<GENERAR>

# --- Proveedor de reserva opcional (fase 5): cualquier API compatible con OpenAI
# (Azure OpenAI, OpenAI, Ollama, LM Studio). Vacío = solo Claude, con modelos de reserva.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180

# --- Embeddings (fase 5) ---
# local: modelo multilingüe dentro del contenedor ai_service, sin clave ni coste (por defecto).
# voyage: Voyage AI (pon VOYAGE_API_KEY). Cambiar de modelo obliga a reindexar (Admin -> IA -> RAG).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VOYAGE_API_KEY=

# --- Núcleo de IA en el backend (fase 5) ---
# Modelos, prompts, presupuestos y precios se gestionan desde Admin -> IA.
AI_ENABLED=true                     # false: la plataforma funciona sin IA
AI_AUTO_ENRICH=true                 # resumen y palabras clave de cada documento subido (Haiku, céntimos)
RATE_LIMIT_AI=10                    # peticiones de IA por minuto y usuario
RAG_SCORE_THRESHOLD=0.35            # similitud mínima de un fragmento para usarlo como fuente
RAG_MAX_CHUNKS=6                    # fuentes por respuesta
RAG_EVAL_SAMPLE_RATE=0.05           # proporción de respuestas que se evalúan automáticamente
SEMANTIC_SCORING=true               # puntuación de oportunidades con embeddings
AI_SAMPLE_RETENTION_DAYS=30         # días que se guarda la muestra de cada respuesta (RGPD)
AI_USD_EUR_RATE=0.92                # cambio para el informe de ROI
